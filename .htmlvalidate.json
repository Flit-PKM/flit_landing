{
  "root": true,
  "extends": ["html-validate:document"],
  "rules": {
    "input-missing-label": "off",
    "no-inline-style": "off",
    "void-style": "off",
    "element-permitted-content": "off",
    "element-permitted-occurrences": "off",
    "heading-level": "off",
    "require-sri": "off"
  }
}
